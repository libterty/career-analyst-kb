# ── LLM Provider ──────────────────────────────────────────────────────
# 選擇 provider: ollama | grok | openai
LLM_PROVIDER=ollama

# Ollama（本機，預設）
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:12b         # 推薦: gemma3:12b | gemma3:27b | gemma2:9b

# xAI Grok（雲端）
# LLM_PROVIDER=grok
# LLM_MODEL=grok-beta          # 或 grok-2
# GROK_API_KEY=xai-...

# OpenAI（fallback）
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# Claude 
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-...

# ── Embedding ──────────────────────────────────────────────────────────
# 預設跟隨 LLM_PROVIDER（ollama → nomic-embed-text, openai → text-embedding-3-large）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text   # 768 dim；換模型時須同步更新 EMBEDDING_DIM
# EMBEDDING_DIM=768              # 留空則自動推斷；換模型前先刪除舊 Milvus collection

# Vector Database (Milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19531
MILVUS_COLLECTION=beeinventor_kb

# Relational Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://beeinventor:secret@localhost:5437/beeinventor_kb

# Security
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_ENV=development          # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Sessions
MAX_MESSAGES_PER_SESSION=100

# Admin seed (auto-creates admin account on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# VoltAgent (optional, only needed when running --profile voltagent)
VOLTAGENT_MODEL=qwen2.5:7b
VOLTAGENT_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# VoltAgent Multi-Model (voltagent-bee)
# LLM_PROVIDER=anthropic  → uses ANTHROPIC_API_KEY + SUPERVISOR/WORKER/JUDGE_MODEL
# LLM_PROVIDER=ollama     → uses OLLAMA_BASE_URL + SUPERVISOR/WORKER/JUDGE_MODEL (free)
LLM_PROVIDER=anthropic
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
SUPERVISOR_MODEL=claude-haiku-4-5-20251001
WORKER_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-haiku-4-5-20251001
# Ollama example (switch provider without rebuild):
# LLM_PROVIDER=ollama
# SUPERVISOR_MODEL=qwen3:30b-a3b
# WORKER_MODEL=qwen3:30b-a3b
# JUDGE_MODEL=qwen3:30b-a3b
# B-5: Batch + CDC Ingestion
# BATCH_WATCH_DIR=/path/to/watch   # 空字串 = 停用 batch scheduler
BATCH_WATCH_DIR=
BATCH_INTERVAL_SECONDS=3600
CDC_ENABLED=false
TOMBSTONE_PURGE_INTERVAL_SECONDS=1800

# C-3: Domain API Integration (leave blank to disable)
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BEE
CRM_BASE_URL=
CRM_API_TOKEN=
IOT_API_BASE_URL=
IOT_API_TOKEN=

# Langfuse observability (optional — tracing disabled if not set)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
