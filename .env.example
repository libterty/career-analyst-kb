# ── LLM Provider ──────────────────────────────────────────────────────
# 選擇 provider: ollama | openai | grok | anthropic
LLM_PROVIDER=ollama

# Ollama（本機，預設）
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3-30b-a3b      # 推薦: qwen3-30b-a3b | gemma3:12b | qwen3:8b

# xAI Grok（雲端）
# LLM_PROVIDER=grok
# LLM_MODEL=grok-beta
# GROK_API_KEY=xai-...

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# Anthropic Claude（cloud fallback）
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# ── Embedding ──────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text   # 768 dim
# EMBEDDING_DIM=768

# ── Vector Database (Milvus) ───────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=career_kb

# ── Relational Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://career:secret@localhost:5436/career_kb

# ── Security ───────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── App ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ── Sessions ───────────────────────────────────────────────────────────
MAX_MESSAGES_PER_SESSION=100

# ── Admin seed（首次啟動自動建立管理員帳號）───────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ── VoltAgent Multi-Model ─────────────────────────────────────────────
# LLM_PROVIDER=anthropic  → uses ANTHROPIC_API_KEY + SUPERVISOR/WORKER/JUDGE_MODEL
# LLM_PROVIDER=ollama     → uses OLLAMA_BASE_URL + SUPERVISOR/WORKER/JUDGE_MODEL (free)
SUPERVISOR_MODEL=qwen3-30b-a3b
WORKER_MODEL=qwen3-30b-a3b
JUDGE_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=sk-ant-...

# ── SearXNG web search（由 docker-compose 管理，通常不需手動設定）───────
# SEARXNG_URL=http://searxng:8080   # Docker 內部；本機開發改 http://localhost:8080

# ── Langfuse observability（optional，留空停用）────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
